FLASK_SECRET_KEY=replace-with-a-long-random-value
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-10-characters
# Local mode: defaults to instance/lab.sqlite3 and instance/uploads
# LAB_DATABASE=C:/path/to/lab.sqlite3
# LAB_UPLOADS=C:/path/to/uploads

# Vercel mode: use a pooled PostgreSQL connection string from Supabase.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres?sslmode=require

# Optional Cloudflare R2 storage. Set all four values together; the bucket remains private.
# R2_BUCKET=lab-equipment-files
# R2_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
# R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
